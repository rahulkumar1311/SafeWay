{
  "name": "safeway-ai-backend",
  "version": "1.0.0",
  "description": "SafeWay-AI Backend API Services",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:ai": "python ../ai/app.py",
    "dev:all": "concurrently \"npm run start:ai\" \"npm run dev\"",
    "test": "node --test src/tests/*.test.js",
    "seed:rules": "node src/scripts/seedTrafficRules.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongoose": "^8.5.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4"
  }
}
